    dmz_dvwa.vm.provision 'shell', name: 'configure_gateway', inline: <<-SHELL
      echo "=========================================="
      echo "Configurando gateway: 192.168.60.1"
      echo "Sistema: dmz_dvwa"
      echo "=========================================="
      
      # Detectar la interfaz de red principal
      INTERFACE=$(ip route | grep "192.168" | head -1 | awk '{print $3}')
      if [ -z "$INTERFACE" ]; then
        INTERFACE="eth0"
      fi
      echo "Interfaz detectada: $INTERFACE"
      
      # Limpiar rutas por defecto antiguas
      echo "Limpiando rutas antiguas..."
      ip route del default 2>/dev/null || true
      
      # Añadir la nueva ruta por defecto
      echo "Añadiendo ruta por defecto via 192.168.60.1..."
      if ip route add default via 192.168.60.1; then
        echo "✓ Ruta añadida correctamente"
      else
        echo "Intentando con replace..."
        ip route replace default via 192.168.60.1
      fi
      
      # Hacer la configuración persistente
      echo "Haciendo configuración persistente..."
      
      # Backup del archivo de interfaces
      if [ ! -f /etc/network/interfaces.secgen.bak ]; then
        cp /etc/network/interfaces /etc/network/interfaces.secgen.bak
      fi
      
      # Añadir gateway a /etc/network/interfaces si no existe
      if ! grep -q "gateway 192.168.60.1" /etc/network/interfaces; then
        if grep -q "iface $INTERFACE inet static" /etc/network/interfaces; then
          sed -i "/iface $INTERFACE inet static/a \\    gateway 192.168.60.1" /etc/network/interfaces
          echo "✓ Gateway añadido a /etc/network/interfaces"
        else
          echo "⚠ No se encontró configuración static para $INTERFACE"
        fi
      else
        echo "✓ Gateway ya existe en /etc/network/interfaces"
      fi
      
      # Crear script de inicio para asegurar el gateway
      cat > /etc/network/if-up.d/z99-secgen-gateway << 'EOFGATEWAY'
#!/bin/bash
# SecGen: Ensure default gateway is configured
GATEWAY="192.168.60.1"
ip route show | grep -q "default via $GATEWAY" || {
  ip route del default 2>/dev/null
  ip route add default via $GATEWAY 2>/dev/null || ip route replace default via $GATEWAY
}
exit 0
EOFGATEWAY
