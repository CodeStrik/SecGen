      echo "=========================================="
      
      # Detectar la interfaz de red principal
      INTERFACE=$(ip route | grep "192.168" | head -1 | awk '{print $3}')
      if [ -z "$INTERFACE" ]; then
        INTERFACE="eth0"
      fi
      echo "Interfaz detectada: $INTERFACE"
      
      # Limpiar rutas por defecto antiguas
      echo "Limpiando rutas antiguas..."
      ip route del default 2>/dev/null || true
      
      # Añadir la nueva ruta por defecto
      echo "Añadiendo ruta por defecto via 192.168.70.1..."
      if ip route add default via 192.168.70.1; then
        echo "✓ Ruta añadida correctamente"
      else
        echo "Intentando con replace..."
        ip route replace default via 192.168.70.1
      fi
      
      # Hacer la configuración persistente
      echo "Haciendo configuración persistente..."
      
      # Backup del archivo de interfaces
      if [ ! -f /etc/network/interfaces.secgen.bak ]; then
        cp /etc/network/interfaces /etc/network/interfaces.secgen.bak
      fi
      
      # Añadir gateway a /etc/network/interfaces si no existe
      if ! grep -q "gateway 192.168.70.1" /etc/network/interfaces; then
        if grep -q "iface $INTERFACE inet static" /etc/network/interfaces; then
          sed -i "/iface $INTERFACE inet static/a \\    gateway 192.168.70.1" /etc/network/interfaces
